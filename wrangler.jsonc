{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saastainednumbers",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  // Build is run explicitly (scripts/deploy.sh / CI) before `wrangler deploy`.
  // A build{} hook here makes wrangler set a non-standard NODE_ENV that crashes
  // Next prerendering of /embed pages.
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
