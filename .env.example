# OpenRouter — used by the AI chat widget (browser-side)
# Used exclusively with openrouter/free (free models only — zero cost)
# Create a key at https://openrouter.ai/keys with a low credit limit
NEXT_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-...

# Google AdSense — set to your publisher ID (without the "ca-pub-" prefix)
# Get this from https://www.google.com/adsense/
NEXT_PUBLIC_ADSENSE_ID=
# Ad slot IDs from your AdSense dashboard (numeric values)
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
